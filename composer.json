{
  "$schema": "https://getcomposer.org/schema.json",
  "autoload": {
    "files": [
      "app/helpers.php"
    ],
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    },
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "description": "ATS Skill LMS \u2014 Laravel 13 rebuild of the SkillGro-based LMS (Phase 2 scaffold).",
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "keywords": [
    "laravel",
    "lms",
    "ats-skill"
  ],
  "license": "MIT",
  "minimum-stability": "stable",
  "name": "sabbirhossen44/newatsskill",
  "prefer-stable": true,
  "require": {
    "dompdf/dompdf": "^3.0",
    "guzzlehttp/guzzle": "^7.8",
    "intervention/image": "^3.0",
    "karim007/laravel-bkash-tokenize": "^2.0",
    "laravel/framework": "^13.17",
    "laravel/sanctum": "^4.0",
    "laravel/socialite": "^5.0",
    "laravel/tinker": "^3.0",
    "php": "^8.3",
    "pusher/pusher-php-server": "^7.0",
    "razorpay/razorpay": "^2.0",
    "spatie/laravel-permission": "^6.0",
    "srmklive/paypal": "^3.0",
    "stripe/stripe-php": "^16.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pail": "^1.2.5",
    "laravel/pao": "^1.0.6",
    "laravel/pint": "^1.27",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^12.5.12"
  },
  "type": "project"
}